{
  "name": "markdownattractor",
  "displayName": "markdownattractor",
  "version": "0.1.1",
  "description": "Claude answers from your ADRs, runbooks, specs and notes, and shows the exact lines and when they last changed. A live, time-aware markdown index in one Rust binary; your own API key or a free local model.",
  "icon": "logo/mda_logo.jpg",
  "author": {
    "name": "Joe Carr",
    "email": "joe.carr.data@gmail.com",
    "url": "https://github.com/joe-carr-data"
  },
  "homepage": "https://github.com/joe-carr-data/markdownattractor",
  "repository": "https://github.com/joe-carr-data/markdownattractor",
  "license": "Apache-2.0",
  "mcpServers": {
    "markdownattractor": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mda",
      "args": [
        "mcp"
      ],
      "env": {
        "MDA_ROOT": "${CLAUDE_PROJECT_DIR}",
        "MDA_MODEL_DIR": "${CLAUDE_PLUGIN_DATA}/models"
      }
    }
  },
  "keywords": [
    "markdown",
    "search",
    "knowledge",
    "index",
    "time-aware",
    "context",
    "tokens"
  ]
}
