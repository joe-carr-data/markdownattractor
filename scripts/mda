#!/usr/bin/env bash
# Launcher used by the skills and hooks: finds the right `mda` binary and execs it.
# Same resolution order as bootstrap.sh: the binary is `bin/mda-<this plugin's version>`, so a
# session on another plugin version never runs, or replaces, this one's. When nothing is found it runs bootstrap.sh once to fetch
# the binary, then prints a one-line hint if that failed too.
set -u
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# CLAUDE_PLUGIN_DATA is trusted only when it is this plugin's own directory. A shell started
# by Claude Code's Bash tool can carry another plugin's value (seen: the codex plugin's), and
# the binary and the models would then be looked for, and downloaded, in that plugin's folder.
DATA="$HOME/.claude/plugins/data/markdownattractor-markdownattractor"
case "${CLAUDE_PLUGIN_DATA:-}" in
  */markdownattractor*) DATA="$CLAUDE_PLUGIN_DATA" ;;
esac
# Embedding models and the global nudge switch live in the plugin's own data directory when
# run through the plugin; the binary never reads CLAUDE_PLUGIN_DATA itself.
WANTED="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || echo unknown)"
BIN="$DATA/bin/mda-$WANTED"
export MDA_MODEL_DIR="${MDA_MODEL_DIR:-$DATA/models}"
export MDA_NUDGE_FILE="${MDA_NUDGE_FILE:-$DATA/nudge.off}"

for candidate in "${MDA_BIN:-}" "$BIN" "$ROOT/target/release/mda" "$ROOT/target/debug/mda"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

if command -v mda >/dev/null 2>&1; then
  exec mda "$@"
fi

# Nothing found: the session-start hook has not run, has not finished, or ran against another
# data directory (the MCP server can be started before the hook is done on a first session).
# Fetch the binary now, once, and try again. Everything the hook prints goes to stderr: stdout
# may be an MCP connection. The hook must not start a daemon from here (`MDA_NO_DAEMON`).
if [ "${MDA_NO_FETCH:-0}" != "1" ] && [ -x "$ROOT/scripts/bootstrap.sh" ]; then
  echo "markdownattractor: binary $WANTED not found in $DATA/bin, fetching it once…" >&2
  CLAUDE_PLUGIN_ROOT="$ROOT" CLAUDE_PLUGIN_DATA="$DATA" MDA_NO_DAEMON=1 \
    "$ROOT/scripts/bootstrap.sh" </dev/null >&2 2>&1 || true
  if [ -x "$BIN" ]; then
    exec "$BIN" "$@"
  fi
fi

echo "mda $WANTED binary not found in $DATA/bin and it could not be fetched (see the line above). Run /mda doctor, or: cargo install --git https://github.com/joe-carr-data/markdownattractor mda-cli" >&2
exit 127
