# VHS tape for demo video 2, "saved, then searchable"; filled in by scripts/demo/record-fresh.sh
# (@DEST@, @BIN@). Everything on screen is typed and run for real; no model and no key take part.
Output out.mp4
Set Shell zsh
Set FontFamily "MesloLGS NF"
Set FontSize 20
Set Width 1440
Set Height 810
Set Padding 28
Set Margin 56
Set MarginFill "bg.png"
Set BorderRadius 14
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set CursorBlink false
Hide
Type "cd @DEST@ && export PATH=@BIN@:$PATH PS1='acme-docs %# ' && unset ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY && clear"
Enter
Sleep 1s
Show
Sleep 800ms
Type "mda search canary --raw"
Sleep 400ms
Enter
Sleep 2s
Type "echo '## Canary' >> runbooks/deploy.md"
Sleep 300ms
Enter
Sleep 300ms
Type "echo 'Every release goes to 5% of traffic first.' >> runbooks/deploy.md"
Sleep 300ms
Enter
Sleep 2s
Type "mda search canary --raw"
Sleep 400ms
Enter
Sleep 5s
